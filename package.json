{
  "name": "@snaplyagent/react-native",
  "version": "1.0.0",
  "description": "Snaply Agent for React Native \u2014 consent-first screen capture for support teams: screenshots, live view and remote control, with on-device redaction.",
  "main": "src/index.tsx",
  "react-native": "src/index.tsx",
  "types": "src/index.tsx",
  "files": [
    "src",
    "android/build.gradle",
    "android/src",
    "ios/Sources",
    "ios/Frameworks",
    "SnaplyAgentReactNative.podspec",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "snaply",
    "support",
    "screen-sharing",
    "cobrowsing"
  ],
  "homepage": "https://snaplyagent.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mobile-LLC/SnaplyAgent-SDK-ReactNative.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0"
  },
  "codegenConfig": {
    "name": "SnaplyAgentSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.snaplyagent.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "SnaplyAgent": "SnaplyAgentModule"
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  }
}
